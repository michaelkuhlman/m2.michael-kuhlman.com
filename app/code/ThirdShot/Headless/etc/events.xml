<?xml version="1.0"?>
<!--
  Tell the headless storefront (headless.michael-kuhlman.com) to drop its caches whenever Magento would purge
  Varnish: the same events Magento_CacheInvalidate listens to, so a product, category, CMS or config save shows up
  on the Next.js site within seconds instead of after its 1 hour cache lifetime.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="clean_cache_by_tags">
        <observer name="thirdshot_headless_tags" instance="ThirdShot\Headless\Observer\InvalidateTags"/>
    </event>
    <event name="clean_cache_after_reindex">
        <observer name="thirdshot_headless_tags" instance="ThirdShot\Headless\Observer\InvalidateTags"/>
    </event>
    <event name="catalogrule_after_apply">
        <observer name="thirdshot_headless_tags" instance="ThirdShot\Headless\Observer\InvalidateTags"/>
    </event>
    <event name="adminhtml_cache_flush_system">
        <observer name="thirdshot_headless_all" instance="ThirdShot\Headless\Observer\FlushAll"/>
    </event>
    <event name="adminhtml_cache_flush_all">
        <observer name="thirdshot_headless_all" instance="ThirdShot\Headless\Observer\FlushAll"/>
    </event>
    <event name="adminhtml_cache_refresh_type">
        <observer name="thirdshot_headless_all" instance="ThirdShot\Headless\Observer\FlushAll"/>
    </event>
    <event name="clean_media_cache_after">
        <observer name="thirdshot_headless_all" instance="ThirdShot\Headless\Observer\FlushAll"/>
    </event>
    <event name="clean_catalog_images_cache_after">
        <observer name="thirdshot_headless_all" instance="ThirdShot\Headless\Observer\FlushAll"/>
    </event>
    <event name="controller_action_postdispatch_adminhtml_system_config_save">
        <observer name="thirdshot_headless_all" instance="ThirdShot\Headless\Observer\FlushAll"/>
    </event>
</config>
