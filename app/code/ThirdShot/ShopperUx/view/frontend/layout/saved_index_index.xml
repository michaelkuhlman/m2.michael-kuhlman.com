<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Saved items</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="ts.ux.saved" template="ThirdShot_ShopperUx::saved.phtml"/>
            <block class="Magento\Framework\View\Element\Template" name="ts.ux.recent" after="ts.ux.saved"
                   template="ThirdShot_ShopperUx::strip.phtml">
                <arguments>
                    <argument name="kind" xsi:type="string">recent</argument>
                    <argument name="title" xsi:type="string" translate="true">Recently viewed</argument>
                    <argument name="limit" xsi:type="number">8</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
