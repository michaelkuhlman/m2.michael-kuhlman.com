<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="layout_load_before">
        <observer name="thirdshot_shopperux_quickview" instance="ThirdShot\ShopperUx\Observer\QuickViewHandle"/>
    </event>
    <!-- short top-level labels in the main menu (full names stay on the category pages) -->
    <event name="page_block_html_topmenu_gethtml_before">
        <observer name="thirdshot_shopperux_short_menu_labels" instance="ThirdShot\ShopperUx\Observer\ShortMenuLabels"/>
    </event>
</config>
