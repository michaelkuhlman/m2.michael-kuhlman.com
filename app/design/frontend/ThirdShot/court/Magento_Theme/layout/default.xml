<?xml version="1.0"?>
<!--
  Third Shot Court - site-wide layout.
  Demo notice bar, sticky one-row header, SVG logo, footer rebuilt from a CMS block, compare/wishlist clutter removed.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="after.body.start">
            <block class="Magento\Framework\View\Element\Template" name="ts.demo.notice" before="-"
                   template="Magento_Theme::html/demo-notice.phtml"/>
        </referenceContainer>

        <!-- skip link: the very first stop for keyboard users (Luma keeps it in the hidden panel row) -->
        <move element="skip_to_content" destination="after.body.start" before="-"/>

        <!-- header: one flex row (nav moved into it, account icon added), small UI script.
             Source order = visual order (menu toggle + logo, nav, search, account, saved, bag), so Tab follows
             what the eye sees; CSS `order` still arranges the phone / tablet rows. -->
        <move element="navigation.sections" destination="header-wrapper" after="logo"/>
        <move element="top.search" destination="header-wrapper" after="navigation.sections"/>
        <referenceContainer name="header-wrapper">
            <block class="Magento\Framework\View\Element\Template" name="ts.header.account" after="top.search"
                   template="Magento_Theme::html/header-account.phtml"/>
        </referenceContainer>
        <move element="minicart" destination="header-wrapper" after="-"/>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="ts.ui.script"
                   template="Magento_Theme::html/ui-script.phtml"/>
        </referenceContainer>

        <!-- phone drawer: Help links under Shop / Account -->
        <referenceBlock name="navigation.sections">
            <block class="Magento\Framework\View\Element\Template" name="store.help" group="navigation-sections"
                   after="store.links" template="Magento_Theme::html/drawer-help.phtml">
                <arguments>
                    <argument name="title" translate="true" xsi:type="string">Help</argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo.svg</argument>
                <argument name="logo_width" xsi:type="number">214</argument>
                <argument name="logo_height" xsi:type="number">60</argument>
                <argument name="logo_alt" xsi:type="string">Third Shot Supply Co.</argument>
            </arguments>
        </referenceBlock>

        <!-- footer: newsletter band + CMS link columns + legal line -->
        <referenceContainer name="footer">
            <block class="Magento\Cms\Block\Block" name="ts.footer.columns">
                <arguments>
                    <argument name="block_id" xsi:type="string">ts-footer-columns</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceBlock name="form.subscribe" remove="true"/>
        <referenceBlock name="footer_links" remove="true"/>
        <referenceBlock name="report.bugs" remove="true"/>
        <referenceBlock name="store_switcher" remove="true"/>
        <referenceBlock name="copyright">
            <arguments>
                <argument name="template" xsi:type="string">Magento_Theme::html/copyright.phtml</argument>
            </arguments>
        </referenceBlock>

        <!-- less clutter -->
        <referenceBlock name="catalog.compare.link" remove="true"/>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceBlock name="wishlist_sidebar" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
    </body>
</page>
