<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Magento\Cms\Block\Block" name="ts.pdp.usps" after="product.info.extrahint">
                <arguments>
                    <argument name="block_id" xsi:type="string">ts-pdp-usps</argument>
                </arguments>
            </block>
        </referenceContainer>
        <move element="product.info.overview" destination="product.info.main" after="product.info.price"/>
        <referenceBlock name="product.info.mailto" remove="true"/>
        <referenceBlock name="view.addto.compare" remove="true"/>
        <!-- upsell: drop products the related strip already shows, hide it when fewer than two are left -->
        <referenceBlock name="product.info.upsell" template="Magento_Catalog::product/list/upsell.phtml"/>
    </body>
</page>
