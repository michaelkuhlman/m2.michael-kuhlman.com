<?php
/**
 * Product list toolbar
 *
 * @var $block \Magento\Catalog\Block\Product\ProductList\Toolbar
 *
 * ThirdShot: shopper-facing labels for Magento's sort keys ("Position" means nothing to a shopper). Done here, not
 * in i18n, because "Product Name" / "Position" are also used by order tables and the admin.
 */
$tsSortLabels = ['position' => __('Featured'), 'name' => __('Name'), 'price' => __('Price'), 'relevance' => __('Relevance')];
// Price is offered both ways ("price~asc" / "price~desc": the toolbar mixin sets order AND direction), so phones,
// which have no direction arrow, can sort high to low too.
$tsDesc = $block->getCurrentDirection() === 'desc';
$tsOptions = [];
foreach ($block->getAvailableOrders() as $_key => $_order) {
    if ($_key === 'price') {
        $tsOptions[] = ['price~asc', __('Price: low to high'), $block->isOrderCurrent('price') && !$tsDesc];
        $tsOptions[] = ['price~desc', __('Price: high to low'), $block->isOrderCurrent('price') && $tsDesc];
    } else {
        $tsOptions[] = [$_key, $tsSortLabels[$_key] ?? __($_order), $block->isOrderCurrent($_key)];
    }
}
?>
<div class="toolbar-sorter sorter">
    <label class="sorter-label" for="sorter"><?= $block->escapeHtml(__('Sort by')) ?></label>
    <select id="sorter" data-role="sorter" class="sorter-options">
        <?php foreach ($tsOptions as [$_value, $_label, $_selected]) :?>
            <option value="<?= $block->escapeHtmlAttr($_value) ?>"<?= $_selected ? ' selected="selected"' : '' ?>>
                <?= $block->escapeHtml($_label) ?>
            </option>
        <?php endforeach; ?>
    </select>
    <?php if ($block->getCurrentDirection() == 'desc') :?>
        <a title="<?= $block->escapeHtmlAttr(__('Set Ascending Direction')) ?>"
           href="#"
           class="action sorter-action sort-desc"
           data-role="direction-switcher"
           data-value="asc">
            <span><?= $block->escapeHtml(__('Set Ascending Direction')) ?></span>
        </a>
    <?php else :?>
        <a title="<?= $block->escapeHtmlAttr(__('Set Descending Direction')) ?>"
           href="#"
           class="action sorter-action sort-asc"
           data-role="direction-switcher"
           data-value="desc">
            <span><?= $block->escapeHtml(__('Set Descending Direction')) ?></span>
        </a>
    <?php endif; ?>
</div>
