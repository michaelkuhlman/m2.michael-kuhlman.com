<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Popular searches</title>
    </head>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Popular searches</argument>
            </action>
        </referenceBlock>
        <!-- breadcrumbs like the other content pages (the title otherwise sits right under the header) -->
        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">home</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">Home</item>
                    <item name="label" xsi:type="string" translate="true">Home</item>
                    <item name="link" xsi:type="url" path="/"/>
                </argument>
            </action>
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">popular</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string" translate="true">Popular searches</item>
                    <item name="label" xsi:type="string" translate="true">Popular searches</item>
                </argument>
            </action>
        </referenceBlock>
        <!-- title inside the content column so it shares the grid with the help card -->
        <move element="page.main.title" destination="content" before="-"/>
        <referenceContainer name="content">
            <block class="Magento\Cms\Block\Block" name="ts.help.card" after="-">
                <arguments>
                    <argument name="block_id" xsi:type="string">ts-help-card</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
